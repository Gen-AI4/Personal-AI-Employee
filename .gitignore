# Vault runtime data (may contain personal/sensitive content)
vault/Inbox/*.md
vault/Needs_Action/*.md
vault/Done/*.md
vault/Plans/PLAN_*.md
vault/Pending_Approval/*.md
vault/Approved/*.md
vault/Rejected/*.md
vault/Briefings/*.md
vault/Accounting/*.md

# Obsidian internal config (user-specific)
vault/.obsidian/

# Pytest cache
.pytest_cache/

# Session data
sessions/
*.session

# Orchestrator log file
vault/Logs/orchestrator.log
