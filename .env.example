# Personal AI Employee - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# === Core Settings ===

# Vault path - absolute path to your Obsidian vault
VAULT_PATH=./vault

# Development mode - set to "true" to prevent real external actions
DEV_MODE=true

# Dry run - logs intended actions without executing
DRY_RUN=true

# Check interval in seconds for watchers
CHECK_INTERVAL=10

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# === FileSystem Watcher (Bronze) ===

# File system watcher - path to monitor for new file drops
WATCH_FOLDER=./vault/Inbox

# === Gmail Watcher (Silver) ===

# Enable Gmail watcher (requires OAuth2 credentials)
ENABLE_GMAIL=false

# Path to Gmail OAuth2 credentials JSON file
GMAIL_CREDENTIALS=credentials.json

# Path to saved Gmail auth token (auto-created on first auth)
GMAIL_TOKEN=token.json

# Gmail search query filter
GMAIL_QUERY=is:unread is:important

# === LinkedIn Watcher (Silver) ===

# Enable LinkedIn watcher (requires Playwright MCP server)
ENABLE_LINKEDIN=false

# Path to Playwright persistent browser session
LINKEDIN_SESSION_PATH=

# Path to MCP client script
MCP_CLIENT_PATH=.claude/skills/browsing-with-playwright/scripts/mcp-client.py

# Playwright MCP server URL
MCP_SERVER_URL=http://localhost:8808

# === Facebook Watcher (Gold) ===

# Enable Facebook watcher (requires Playwright MCP server)
ENABLE_FACEBOOK=false

# Path to Playwright persistent browser session for Facebook
FACEBOOK_SESSION_PATH=

# === Instagram Watcher (Gold) ===

# Enable Instagram watcher (requires Playwright MCP server)
ENABLE_INSTAGRAM=false

# Path to Playwright persistent browser session for Instagram
INSTAGRAM_SESSION_PATH=

# === Twitter / X Watcher (Gold) ===

# Enable Twitter watcher (requires Playwright MCP server)
ENABLE_TWITTER=false

# Path to Playwright persistent browser session for Twitter
TWITTER_SESSION_PATH=

# === Odoo Accounting Integration (Gold) ===

# Enable Odoo accounting integration
ENABLE_ODOO=false

# Odoo instance URL
ODOO_URL=http://localhost:8069

# Odoo database name
ODOO_DB=odoo

# Odoo login username
ODOO_USER=admin

# Odoo login password (keep secret — never commit this)
ODOO_PASSWORD=

# === CEO Briefing (Gold) ===

# Enable weekly Monday Morning CEO Briefing (generated Sundays at 20:00 UTC)
ENABLE_CEO_BRIEFING=true
